# Copy to backend/.env and fill in. Never commit backend/.env.
# Everything except ANTHROPIC_API_KEY is optional: rails you don't configure
# run in simulated mode or are reported as unavailable.

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=your_key_here
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_FALLBACKS=true            # server-side refusal fallback (beta)

# --- Wallet -----------------------------------------------------------------
# WALLET_INITIAL_BALANCE_USD=10
# CARD_TOPUP_USD=10
# DEMO_MODE=true                   # enables /demo/* helper endpoints
# LEDGER_DB_PATH=backend/data/autowallet.db   # empty = in-memory ledger

# --- Stripe (card top-ups, payments >= $0.50) ----------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_MIN_CHARGE_USD=0.50
# STRIPE_ALLOW_LIVE_KEYS=false

# --- Micropayment rail for charges under the Stripe minimum --------------------
# MICROPAYMENT_RAIL=robinhood_chain   # or: circle

# --- Robinhood Chain (USDG transfers) -----------------------------------------
# simulated | testnet (chain 46630) | mainnet (chain 4663, real USDG)
ROBINHOOD_CHAIN_MODE=simulated
# ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# ROBINHOOD_CHAIN_TOKEN_ADDRESS=      # defaults to USDG on mainnet; required on testnet
# ROBINHOOD_CHAIN_TOKEN_DECIMALS=6
# AGENT_WALLET_PRIVATE_KEY=0x...      # pays merchants; needs ETH for gas + USDG
# TREASURY_PRIVATE_KEY=0x...          # refills the agent wallet during auto top-up
# MERCHANT_ADDRESS=0x...              # receives search payments

# --- Robinhood Crypto Trading API (treasury buys) ------------------------------
# simulated | live (real orders, real money)
ROBINHOOD_CRYPTO_MODE=simulated
# ROBINHOOD_API_KEY=
# ROBINHOOD_PRIVATE_KEY=              # base64 32-byte Ed25519 seed
# ROBINHOOD_TOPUP_SYMBOL=USDC-USD

# --- Auto top-up policy -------------------------------------------------------
# AUTO_TOPUP_ENABLED=true
# AUTO_TOPUP_THRESHOLD_USD=1.00
# AUTO_TOPUP_AMOUNT_USD=5.00
# AUTO_TOPUP_DAILY_CAP_USD=25.00

# --- Circle (fallback micropayment rail) ---------------------------------------
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_WALLET_ADDRESS=0xYourDestinationWalletAddress
# CIRCLE_SOURCE_WALLET_ID=
# CIRCLE_TOKEN_ID=

# --- Scoped payment tokens / public endpoint -----------------------------------
# SPT_SIGNING_SECRET=                 # random per process if unset
# SPT_ISSUER_KEY=                     # required to call /spt/issue outside DEMO_MODE
# SPT_MAX_AMOUNT_USD=1.00
# PUBLIC_ENDPOINT_URL=http://localhost:8000

# --- Search -------------------------------------------------------------------
# BRAVE_SEARCH_API_KEY=               # real results; mock results if unset
